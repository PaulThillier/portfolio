---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="About — Paul Thillier" description="Electrical engineering student, FIRST Robotics alumni, musician.">
  <Nav />

  <main style="max-width:760px;margin:0 auto;padding:56px 32px 96px;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;gap:32px;margin-bottom:56px;flex-wrap:wrap;">
      <img src="/assets/Profile_Picture.jpg" alt="Paul Thillier" style="width:120px;height:120px;border-radius:50%;object-fit:cover;object-position:center top;border:2px solid var(--border);flex-shrink:0;" />
      <div>
        <p style="font-family:'DM Mono',monospace;font-size:11px;color:var(--text-3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px;">About</p>
        <h1 style="font-size:clamp(24px,4vw,40px);font-weight:300;letter-spacing:-0.02em;color:var(--text);margin-bottom:12px;">Paul Thillier</h1>
        <p style="font-size:15px;color:var(--text-2);line-height:1.7;max-width:480px;">Electrical engineering student at ASU, graduating December 2026. Born in France, moved to the US in 2008 — dual citizen, native in both English and French.</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;">
          {['Mesa, AZ', 'French · English', 'ASU EEE · Dec 2026', '3.3 GPA'].map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Experience -->
    <div style="margin-bottom:48px;">
      <p class="section-label">Experience</p>

      <div class="exp-item">
        <div class="exp-dot"></div>
        <div style="flex:1;">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
            <p style="font-size:14px;font-weight:500;color:var(--text);">Tech Research Summer Intern — Intel</p>
            <p class="mono-sm">May–Aug 2025</p>
          </div>
          <p class="role-sub">Hillsboro, OR · Phy Die Interconnect Group</p>
          <p style="font-size:13px;color:var(--text-2);line-height:1.6;margin-top:6px;">Developed test methodologies for advanced packaging interconnects. Worked on characterization of die-to-die interfaces and contributed to reliability analysis workflows.</p>
        </div>
      </div>

      <div class="exp-item">
        <div class="exp-dot"></div>
        <div style="flex:1;">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
            <p style="font-size:14px;font-weight:500;color:var(--text);">Automotive Mechanic — Desert Dawg Auto Repair</p>
            <p class="mono-sm">2022 – Present</p>
          </div>
          <p class="role-sub">Mesa, AZ</p>
          <p style="font-size:13px;color:var(--text-2);line-height:1.6;margin-top:6px;">Diagnose and repair vehicles across a wide range of makes and models. Specialize in electrical diagnostics, engine work, and suspension systems.</p>
        </div>
      </div>
    </div>

    <!-- Skills -->
    <div style="margin-bottom:48px;">
      <p class="section-label">Skills</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        {[
          { cat: 'EDA / Design', items: ['Cadence Virtuoso', 'Altium Designer', 'EasyEDA', 'LTspice'] },
          { cat: 'Programming', items: ['C / Embedded C', 'Python', 'Java', 'MATLAB'] },
          { cat: 'Hardware', items: ['PCB Design', 'Soldering / Rework', 'Oscilloscope / DMM', 'FPGA'] },
          { cat: 'Fabrication', items: ['3D Printing', 'FDM / CAD', 'Fusion 360', 'Laser Cutting'] },
        ].map(group => (
          <div class="card">
            <p class="card-label">{group.cat}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              {group.items.map(item => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- FIRST Robotics -->
    <div style="margin-bottom:48px;">
      <p class="section-label">FIRST Robotics</p>
      <div class="card">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;">
          <img src="/assets/FIRST-Alumni.webp" alt="FIRST Alumni" style="height:48px;width:auto;object-fit:contain;flex-shrink:0;" />
          <div>
            <p style="font-size:15px;font-weight:500;color:var(--text);">FIRST Robotics Alumni</p>
            <p class="role-sub">2016–2020 · Desert Mountain High School</p>
          </div>
        </div>
        <p style="font-size:13px;color:var(--text-2);line-height:1.7;margin-bottom:16px;">Four years competing — two in FRC (Team 6314) and two in FTC (Team 15430). From building a 119-lb robot that placed 3rd at World Championships to mentoring younger students at competitions.</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
          {['FRC Team 6314', 'FTC Team 15430', '3rd Place Worlds', 'Gracious Professionalism Award'].map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <a href="/robotics" class="btn btn-secondary btn-sm">View full robotics page →</a>
      </div>
    </div>

    <!-- Education -->
    <div style="margin-top:48px;margin-bottom:48px;">
      <p class="section-label">Education</p>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <div class="card">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
            <p style="font-size:14px;font-weight:500;color:var(--text);">B.S.E., Electrical Engineering</p>
            <p class="mono-sm">Graduating Dec 2026</p>
          </div>
          <p class="role-sub" style="margin-bottom:6px;">Arizona State University · 3.3 GPA</p>
          <p style="font-size:12px;color:var(--text-2);">Digital Systems & Circuits · Hardware Design Lang/Prog Logic · Signals and Systems · VLSI Design · Embedded Systems</p>
        </div>
        <div class="card">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
            <p style="font-size:14px;font-weight:500;color:var(--text);">High School Diploma</p>
            <p class="mono-sm">2020</p>
          </div>
          <p class="role-sub">Desert Mountain High School · Scottsdale, AZ</p>
        </div>
      </div>
    </div>

    <!-- Music -->
    <div style="margin-bottom:48px;">
      <p class="section-label">Music</p>
      <div class="card">
        <p style="font-size:13px;color:var(--text-2);line-height:1.7;margin-bottom:12px;">Piano and guitar since childhood, marching band percussion through high school. Music and engineering scratch the same itch — both reward precision and practice.</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {['Piano', 'Guitar', 'Marching Band · Percussion'].map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </div>

  </main>
</Layout>

<style is:global>
.section-label {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  color: var(--text-3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}
.card {
  padding: 16px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  margin-bottom: 12px;
}
.tag {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: 20px;
  color: var(--text-2);
  background: var(--surface-2);
}
.exp-item {
  display: flex;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}
.exp-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  margin-top: 6px;
  flex-shrink: 0;
}
.role-sub {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  color: var(--text-3);
  letter-spacing: 0.04em;
}
.mono-sm {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  color: var(--text-2);
}
.card-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  color: var(--text-2);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
</style>
