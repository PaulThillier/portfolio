---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="FIRST Robotics — Paul Thillier" description="4 years in FIRST Robotics Competition — FRC Team 6314 and FTC Team 15430.">
  <Nav />

  <main style="max-width:860px;margin:0 auto;padding:56px 32px 96px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <a href="/about" style="font-family:'DM Mono',monospace;font-size:11px;color:var(--text3);text-decoration:none;letter-spacing:0.06em;display:inline-flex;align-items:center;gap:6px;margin-bottom:32px;" onmouseover="this.style.color='var(--text2)'" onmouseout="this.style.color='var(--text3)'">← About</a>
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap;">
        <img src="/assets/FIRST-Alumni.webp" alt="FIRST Alumni" style="height:48px;width:auto;object-fit:contain;filter:brightness(1.3);" />
      </div>
      <h1 style="font-size:clamp(24px,4vw,44px);font-weight:300;letter-spacing:-0.02em;color:var(--text);margin-bottom:12px;">4 Years in FIRST Robotics</h1>
      <p style="font-size:15px;color:var(--text2);line-height:1.75;max-width:640px;">
        From 2016 to 2020 I competed in FIRST Robotics — two years in the FIRST Robotics Competition (FRC) with Team 6314, then two years in the FIRST Tech Challenge (FTC) with Team 15430. It's the experience that made me an engineer.
      </p>
    </div>

    <!-- What is FIRST -->
    <div style="margin-bottom:56px;padding:24px 28px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;">
      <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:12px;">What is FIRST?</p>
      <p style="font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:12px;">
        For Inspiration and Recognition of Science and Technology (FIRST) is an international youth organization founded by Dean Kamen and Woodie Flowers in 1989. Its goal is to inspire students in engineering and technology through competitive robotics.
      </p>
      <p style="font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:16px;">
        Each match has three phases — a 30-second Autonomous period where robots run on pre-programmed instructions only, a 90-second Driver-Controlled period, and a 30-second End Game with special scoring opportunities.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:8px;">
        {['FRC Team 6314', 'FTC Team 15430', 'Desert Mountain High School', '2016–2020'].map(tag => (
          <span style="font-family:'DM Mono',monospace;font-size:10px;padding:3px 10px;border-radius:10px;background:var(--bg3);color:var(--text3);border:1px solid var(--border);">{tag}</span>
        ))}
      </div>
    </div>

    <!-- FRC Section -->
    <div style="margin-bottom:56px;">
      <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--border);">
        <h2 style="font-size:20px;font-weight:400;color:var(--text);letter-spacing:-0.01em;">FIRST Robotics Competition</h2>
        <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--accent2);">FRC · Team 6314 · 2016–2018</span>
      </div>

      <!-- Sir Brewster -->
      <div style="margin-bottom:48px;">
        <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:4px;">
          <h3 style="font-size:17px;font-weight:500;color:var(--text);">Sir Brewster</h3>
          <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);">2017</span>
        </div>
        <p style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent2);letter-spacing:0.06em;margin-bottom:12px;">FIRST STEAMWORKS</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
          {[
            { label: 'Weight', value: '119 lbs' },
            { label: 'Result', value: '3rd · World Championships' },
            { label: 'Challenges', value: 'Rope climb · Wiffle balls · Gears' },
          ].map(s => (
            <div style="padding:8px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;">
              <p style="font-family:'DM Mono',monospace;font-size:9px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px;">{s.label}</p>
              <p style="font-size:13px;color:var(--text);">{s.value}</p>
            </div>
          ))}
        </div>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;margin-bottom:20px;">
          Our first full competition robot. The Steamworks game required robots to climb a rope, shoot wiffle balls into a boiler, and pick up and place gears onto airship pegs. We placed 3rd at the World Championships in our division — an extraordinary result for a relatively new team.
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;flex-wrap:wrap;">
          <div style="background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
            <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;padding:12px 14px 8px;">Game Explanation</p>
            <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
              <iframe
                src="https://www.youtube.com/embed/EMiNmJW7enI"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
          <div style="background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
            <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;padding:12px 14px 8px;">Carver Finals — World Championships</p>
            <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
              <iframe
                src="https://www.youtube.com/embed/7GoR8esFTYU"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- Sir Hendricks -->
      <div style="margin-bottom:48px;">
        <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:4px;">
          <h3 style="font-size:17px;font-weight:500;color:var(--text);">Sir Hendricks</h3>
          <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);">2018</span>
        </div>
        <p style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent2);letter-spacing:0.06em;margin-bottom:12px;">FIRST POWER UP</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
          {[
            { label: 'Weight', value: '119.6 lbs' },
            { label: 'Result', value: 'World Championships qualifier' },
            { label: 'Challenges', value: 'Cube stacking · Lift 2 robots 1ft' },
          ].map(s => (
            <div style="padding:8px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;">
              <p style="font-family:'DM Mono',monospace;font-size:9px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px;">{s.label}</p>
              <p style="font-size:13px;color:var(--text);">{s.value}</p>
            </div>
          ))}
        </div>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;margin-bottom:20px;">
          Power Up required robots to pick up and stack power cubes on switches and scales, and the endgame challenge was lifting two other robots at least a foot off the floor simultaneously — a serious mechanical engineering challenge. We qualified for Worlds again and developed a custom ramp system for the lift challenge.
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div style="background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
            <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;padding:12px 14px 8px;">Game Explanation</p>
            <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
              <iframe
                src="https://www.youtube.com/embed/HZbdwYiCY74"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
          <div style="background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
            <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;padding:12px 14px 8px;">Our Robot</p>
            <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
              <iframe
                src="https://www.youtube.com/embed/gdS8lDzsgPc"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FTC Section -->
    <div style="margin-bottom:56px;">
      <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--border);">
        <h2 style="font-size:20px;font-weight:400;color:var(--text);letter-spacing:-0.01em;">FIRST Tech Challenge</h2>
        <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--accent2);">FTC · Team 15430 · 2018–2020</span>
      </div>
      <div style="padding:24px 28px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;">
        <p style="font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:12px;">
          After two years in FRC we transitioned to the FIRST Tech Challenge — a smaller scale competition with robots built from REV and TETRIX components, programmed in Java. FTC robots are lighter and more nimble, but the engineering challenges are just as demanding.
        </p>
        <p style="font-size:14px;color:var(--text2);line-height:1.75;">
          Robot names and detailed match footage coming soon — check back as I dig up the archives.
        </p>
      </div>
    </div>

    <!-- Kadima Innovation Fair -->
    <div style="margin-bottom:56px;">
      <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--border);">
        <h2 style="font-size:20px;font-weight:400;color:var(--text);letter-spacing:-0.01em;">Kadima Innovation Fair</h2>
        <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--accent2);">2018</span>
      </div>
      <p style="font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:20px;">
        We were invited to the Kadima Innovation Fair where I got to meet some incredible people — including the Human Calculator and Sophia, the humanoid robot from Hanson Robotics. We actually mounted Sophia onto our robot and brought her out onto the stage. A pretty surreal moment.
      </p>
      <div style="padding:16px 20px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;">
        <p style="font-size:13px;color:var(--text3);font-style:italic;">Photos from Kadima coming soon.</p>
      </div>
    </div>

    <!-- Community -->
    <div style="margin-bottom:56px;">
      <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--border);">
        <h2 style="font-size:20px;font-weight:400;color:var(--text);letter-spacing:-0.01em;">Community & Mentorship</h2>
      </div>
      <p style="font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:16px;">
        Beyond competing, we loved interacting with the community and inspiring the next generation of engineers. I later served as a Robotics Club TA at the International School of Arizona, guiding students through VEX Robotics design, assembly, wiring, and programming.
      </p>
    </div>

    <!-- Awards -->
    <div style="margin-bottom:56px;">
      <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--border);">
        <h2 style="font-size:20px;font-weight:400;color:var(--text);letter-spacing:-0.01em;">Awards</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;">
        {[
          { award: "Chairman's Award", year: '2018', note: "FIRST's most prestigious honor — recognizes the team that best embodies the mission" },
          { award: 'Gracious Professionalism Award', year: '2018', note: 'Exceptional respect, teamwork, and professionalism on and off the field' },
          { award: 'Rookie All-Star Award', year: '2017', note: 'Outstanding first-year achievement in engineering and teamwork' },
          { award: 'Entrepreneurship Award', year: '2017', note: 'Recognized for entrepreneurial spirit and business plan development' },
          { award: 'World Championship Semi-Finalist', year: '2017', note: 'Carver Division — 3rd place at the FIRST World Championships' },
        ].map(a => (
          <div style="display:flex;gap:12px;align-items:flex-start;padding:14px 18px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;">
            <span style="color:var(--accent2);font-size:14px;margin-top:1px;flex-shrink:0;">★</span>
            <div style="flex:1;">
              <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:2px;">
                <p style="font-size:13px;font-weight:500;color:var(--text);">{a.award}</p>
                <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);">{a.year}</span>
              </div>
              <p style="font-size:12px;color:var(--text2);">{a.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Back CTA -->
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <a href="/about" style="font-family:'DM Mono',monospace;font-size:12px;padding:8px 18px;border-radius:20px;border:1px solid var(--border);color:var(--text);text-decoration:none;" onmouseover="this.style.borderColor='var(--border-hover)'" onmouseout="this.style.borderColor='var(--border)'">← Back to About</a>
      <a href="/#projects" style="font-family:'DM Mono',monospace;font-size:12px;padding:8px 18px;border-radius:20px;border:1px solid var(--border);color:var(--text);text-decoration:none;" onmouseover="this.style.borderColor='var(--border-hover)'" onmouseout="this.style.borderColor='var(--border)'">View Projects →</a>
    </div>

  </main>
</Layout>