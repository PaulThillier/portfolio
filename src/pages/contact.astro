---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Contact — Paul Thillier" description="Get in touch with Paul Thillier.">
  <Nav />

  <main style="max-width:600px;margin:0 auto;padding:72px 32px 96px;">

    <p style="font-family:'DM Mono',monospace;font-size:11px;color:var(--text3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:16px;">Contact</p>
    <h1 style="font-size:clamp(24px,4vw,40px);font-weight:300;letter-spacing:-0.02em;color:var(--text);margin-bottom:12px;">Get in touch</h1>
    <p style="font-size:15px;color:var(--text2);line-height:1.7;margin-bottom:48px;">
      Open to internships, co-ops, collaborations, or just talking about a project. Best way to reach me is email.
    </p>

    <div style="display:flex;flex-direction:column;gap:12px;">

      <!-- Email -->
      <a href="mailto:paulthillier@gmail.com"
        style="display:flex;align-items:center;gap:16px;padding:18px 22px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;text-decoration:none;transition:border-color 0.15s;"
        onmouseover="this.style.borderColor='var(--border-hover)'"
        onmouseout="this.style.borderColor='var(--border)'">
        <div style="width:38px;height:38px;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">✉</div>
        <div style="flex:1;">
          <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px;">Email</p>
          <p style="font-size:14px;color:var(--text);">paulthillier@gmail.com</p>
        </div>
        <span style="font-size:16px;color:var(--text3);">→</span>
      </a>

      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/in/paulthillier/" target="_blank" rel="noopener"
        style="display:flex;align-items:center;gap:16px;padding:18px 22px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;text-decoration:none;transition:border-color 0.15s;"
        onmouseover="this.style.borderColor='var(--border-hover)'"
        onmouseout="this.style.borderColor='var(--border)'">
        <div style="width:38px;height:38px;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="2" y="9" width="4" height="12" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="4" cy="4" r="2" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div style="flex:1;">
          <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px;">LinkedIn</p>
          <p style="font-size:14px;color:var(--text);">linkedin.com/in/paulthillier</p>
        </div>
        <span style="font-size:16px;color:var(--text3);">↗</span>
      </a>

      <!-- GitHub -->
      <a href="https://github.com/PaulThillier" target="_blank" rel="noopener"
        style="display:flex;align-items:center;gap:16px;padding:18px 22px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;text-decoration:none;transition:border-color 0.15s;"
        onmouseover="this.style.borderColor='var(--border-hover)'"
        onmouseout="this.style.borderColor='var(--border)'">
        <div style="width:38px;height:38px;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div style="flex:1;">
          <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px;">GitHub</p>
          <p style="font-size:14px;color:var(--text);">github.com/PaulThillier</p>
        </div>
        <span style="font-size:16px;color:var(--text3);">↗</span>
      </a>

    </div>
  </main>
</Layout>
