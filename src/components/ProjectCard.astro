---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  status: 'complete' | 'wip' | 'archived';
  tags: string[];
  versions?: { tag: string; title: string; date: string; note?: string }[];
  image?: string;
}

const { slug, title, description, category, status, tags, versions, image } = Astro.props;

const statusLabel = { complete: null, wip: 'WIP', archived: 'Archived' };
const statusColor = {
  complete: null,
  wip: 'color:var(--wip);background:var(--wip-bg);border:1px solid rgba(201,123,58,0.25)',
  archived: 'color:var(--archived);background:var(--archived-bg);border:1px solid rgba(100,100,100,0.2)',
};
---

<a href={`/projects/${slug}`}
  style="display:flex;flex-direction:column;background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden;text-decoration:none;transition:border-color 0.15s, transform 0.15s;height:100%;"
  onmouseover="this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'"
  onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">

  {image && (
    <div style="width:100%;height:180px;overflow:hidden;flex-shrink:0;">
      <img src={image} alt={title} style="width:100%;height:100%;object-fit:cover;opacity:0.85;transition:opacity 0.15s;" />
    </div>
  )}

  {!image && (
    <div style="width:100%;height:8px;background:linear-gradient(90deg,var(--bg3),var(--bg2));flex-shrink:0;"></div>
  )}

  <div style="display:flex;flex-direction:column;gap:10px;padding:18px 20px 20px;flex:1;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
      <div>
        <p style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:4px;">{category}</p>
        <p style="font-size:14px;font-weight:500;color:var(--text);line-height:1.3;">{title}</p>
      </div>
      {statusLabel[status] && (
        <span style={`font-family:'DM Mono',monospace;font-size:9px;padding:2px 7px;border-radius:10px;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;flex-shrink:0;margin-top:2px;${statusColor[status]}`}>
          {statusLabel[status]}
        </span>
      )}
    </div>

    <p style="font-size:13px;color:var(--text2);line-height:1.55;flex:1;">{description}</p>

    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:12px;border-top:1px solid var(--border);">
      <div style="display:flex;flex-wrap:wrap;gap:5px;">
        {tags.slice(0, 3).map(tag => (
          <span style="font-family:'DM Mono',monospace;font-size:10px;padding:2px 8px;border-radius:10px;background:var(--bg3);color:var(--text3);letter-spacing:0.03em;">{tag}</span>
        ))}
      </div>
      {versions && versions.length > 1 && (
        <div style="display:flex;gap:3px;align-items:center;flex-shrink:0;">
          {versions.map((v, i) => (
            <div style={`width:5px;height:5px;border-radius:50%;background:${i === versions.length - 1 ? 'var(--accent2)' : 'var(--bg3)'};`} title={v.tag}></div>
          ))}
          <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);margin-left:4px;">{versions[versions.length-1].tag}</span>
        </div>
      )}
    </div>
  </div>
</a>
