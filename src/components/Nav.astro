---
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/robotics', label: 'Robotics' },
  { href: '/resume.pdf', label: 'Resume', external: true },
];
---


<nav style="position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:56px;background:rgba(14,14,14,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);">
  <a href="/" style="font-family:'DM Mono',monospace;font-size:13px;color:var(--accent);letter-spacing:0.04em;text-decoration:none;">
    PT /
  </a>
  <div style="display:flex;gap:24px;align-items:center;">
    {links.map(link => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener' : undefined}
        style="font-size:13px;color:var(--text2);text-decoration:none;transition:color 0.15s;"
        onmouseover="this.style.color='var(--text)'"
        onmouseout="this.style.color='var(--text2)'"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/contact"
      style="font-size:12px;padding:5px 14px;border-radius:20px;border:1px solid var(--border);color:var(--text);text-decoration:none;transition:border-color 0.15s;"
      onmouseover="this.style.borderColor='var(--border-hover)'"
      onmouseout="this.style.borderColor='var(--border)'"
    >
      Contact
    </a>
  </div>
</nav>
